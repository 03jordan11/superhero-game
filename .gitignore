# Godot 4+ specific ignores
.godot/
/android/

# Godot export credentials - may contain secrets
export_credentials.cfg

# Windows junk
Thumbs.db
Desktop.ini

# macOS junk
.DS_Store

# IDE/editor folders
.vscode/
.idea/
.vs/

# Temporary files
*.tmp
*.log

# Local exported game builds
builds/

# Generated screenshots, profiling output, temporary authoring files and backups
/artifacts/
/Asset Dashboard.html
/asset-dashboard/validation.json

# Local capture/profiling entry points (keep test_*.gd regression tests tracked)
/tests/render_*.gd
/tests/render_*.gd.uid
/tests/profile_*.gd
/tests/profile_*.gd.uid

# Python caches generated by offline asset tools
__pycache__/
*.py[cod]

# Blender's automatic backup copies; keep the actual .blend source files
*.blend[0-9]*
