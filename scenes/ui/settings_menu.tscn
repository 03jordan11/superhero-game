[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui-scripts/settings_menu.gd" id="1"]

[node name="SettingsMenu" type="PanelContainer"]
visible = false
custom_minimum_size = Vector2(960, 900)
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 24

[node name="Layout" type="VBoxContainer" parent="Margin"]
